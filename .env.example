# Required for admin login — generate with: npm run hash-password -- yourpassword
ADMIN_PASSWORD_HASH=

# Required — any long random string, e.g.: openssl rand -hex 32
SESSION_SECRET=

# Database — local dev uses a file, production (Vercel) uses Turso:
DATABASE_URL=file:./data/app.db
# DATABASE_URL=libsql://your-project-yourorg.turso.io
# TURSO_AUTH_TOKEN=

# Optional
PORT=3000
# NODE_ENV=production
